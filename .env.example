# Copy to .env and replace the placeholder secrets before starting locally.

# PostgreSQL
DB_URL=jdbc:postgresql://localhost:15432/runestone_bank
DB_USERNAME=postgres
DB_PASSWORD=change-me

# Kafka
KAFKA_BOOTSTRAP_SERVERS=localhost:9094

# Mail
APP_USERNAME=your-email@example.com
APP_PASSWORD=change-me

# JWT
# Must be Base64 and decode to at least 32 bytes.
JWT_SECRET=replace-with-a-valid-base64-secret

# Optional. Defaults to 15 minutes.
JWT_EXPIRATION=900000